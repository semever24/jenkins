pipeline {
    agent any     

    stages {
        stage('STAGE1'){    
            steps {
                sh 'sleep 5'
                echo "This is from STAGE1"
            }
        }  

        stage('STAGE2'){ 
            input {
                message "Should we continue?"
                ok "Yes, we should."
                submitter "alice,bob"
                parameters {
                    string(name: 'PERSON', defaultValue: 'Mr Jenkins', description: 'Who should I say hello to?')
                }
            }
            
            steps {
                sh 'sleep 10'
                echo "Hello, ${PERSON}, nice to meet you."
                echo "This is from STAGE2"
            }
        }       
    }    
}
